{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anovelos.example.com/schemas/review-triage-report.schema.json",
  "title": "External Review Triage Report",
  "description": "Machine-readable triage report for external audit findings",
  "type": "object",
  "required": [
    "record_type",
    "schema_version",
    "report_date",
    "audit_report_ref",
    "repository_baseline",
    "findings",
    "observations",
    "summary"
  ],
  "properties": {
    "record_type": {
      "type": "string",
      "const": "external_review_triage_report"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0$"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "audit_report_ref": {
      "type": "object",
      "required": ["path", "baseline"],
      "properties": {
        "path": {"type": "string"},
        "baseline": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "repository_baseline": {
      "type": "object",
      "required": ["branch", "head", "worktree_clean", "plan_version"],
      "properties": {
        "branch": {"type": "string"},
        "head": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "worktree_clean": {"type": "boolean"},
        "plan_version": {"type": "string"},
        "current_task": {"type": "string"},
        "task_status": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/observation"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "confirmed",
        "adopted",
        "deferred",
        "rejected"
      ],
      "properties": {
        "total_findings": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "adopted": {"type": "integer", "minimum": 0},
        "deferred": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "p0_count": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "baseline_status",
        "verification",
        "evidence_level",
        "severity",
        "recommendation_validity",
        "decision",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "claim": {
          "type": "string",
          "minLength": 10
        },
        "baseline_status": {
          "type": "string",
          "enum": ["STILL_PRESENT", "ALREADY_FIXED", "CHANGED", "CANNOT_VERIFY"]
        },
        "verification": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "PARTIALLY_CONFIRMED",
            "ALREADY_FIXED",
            "FALSE_POSITIVE",
            "THEORETICAL_ONLY",
            "NEEDS_MORE_EVIDENCE",
            "CANNOT_VERIFY"
          ]
        },
        "evidence_level": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3", "E4"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": {"type": "string"},
              "ref": {"type": "string"},
              "sha256": {"type": "string"}
            }
          }
        },
        "severity": {
          "type": "string",
          "enum": ["BLOCKER", "P0", "P1", "P2", "P3", "N/A"]
        },
        "recommendation_validity": {
          "type": "string",
          "enum": ["VALID", "PARTIAL", "OVERENGINEERED", "WRONG_SOLUTION", "NOT_NEEDED"]
        },
        "decision": {
          "type": "string",
          "enum": [
            "ADOPT_NOW",
            "ADOPT_WITH_MODIFICATION",
            "DEFER",
            "TRACK_ONLY",
            "REJECT"
          ]
        },
        "owner": {
          "type": "string"
        },
        "root_cause": {
          "type": "string"
        },
        "target_invariant": {
          "type": "string",
          "description": "Required for P0/BLOCKER"
        },
        "candidate_remediation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["APPROVED", "REJECTED", "NEEDS_REVISION"]
            },
            "description": {"type": "string"},
            "files_modified": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "adversarial_validation": {
          "type": "object",
          "description": "Required for P0/BLOCKER",
          "properties": {
            "required": {"type": "boolean"},
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "description", "result"],
                "properties": {
                  "id": {"type": "string"},
                  "description": {"type": "string"},
                  "attack_path": {"type": "string"},
                  "result": {
                    "type": "string",
                    "enum": ["BLOCKED", "SUCCESSFUL_BYPASS", "NOT_APPLICABLE"]
                  }
                }
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "severity": {"enum": ["P0", "BLOCKER"]}
            }
          },
          "then": {
            "required": ["target_invariant", "adversarial_validation"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": {"enum": ["ADOPT_NOW", "ADOPT_WITH_MODIFICATION"]}
            }
          },
          "then": {
            "required": ["candidate_remediation"]
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": ["id", "type", "description", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^O-[0-9]{3}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "expected_future_work",
            "quality_confirmation",
            "design_confirmation",
            "deferred_issue",
            "background_note"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3", "N/A"]
        },
        "owner": {
          "type": "string"
        }
      }
    }
  }
}
