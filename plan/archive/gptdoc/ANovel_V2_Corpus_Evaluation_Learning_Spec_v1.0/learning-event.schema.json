{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/learning-event.schema.json",
  "title": "LearningEvent",
  "type": "object",
  "required": [
    "learning_event_id",
    "proposal_type",
    "target_ref",
    "evidence_refs",
    "proposed_change",
    "authority",
    "status"
  ],
  "properties": {
    "learning_event_id": {
      "type": "string"
    },
    "proposal_type": {
      "enum": [
        "PROMPT_CHANGE",
        "MODEL_POLICY_CHANGE",
        "CONTEXT_POLICY_CHANGE",
        "QUALITY_POLICY_CHANGE",
        "PLANNING_POLICY_CHANGE",
        "REPAIR_POLICY_CHANGE",
        "GENRE_SOFT_RULE_CHANGE",
        "REFERENCE_PROFILE_CHANGE"
      ]
    },
    "target_ref": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_change": {
      "type": "object"
    },
    "authority": {
      "const": "proposal"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "BENCHMARKING",
        "VALIDATED",
        "PROMOTED",
        "REJECTED",
        "ROLLED_BACK"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}