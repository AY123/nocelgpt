{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/reader-signal.schema.json",
  "title": "ReaderSignal",
  "type": "object",
  "required": [
    "signal_id",
    "platform",
    "content_ref",
    "cohort",
    "exposure",
    "metric",
    "value",
    "window",
    "captured_at"
  ],
  "properties": {
    "signal_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "cohort": {
      "type": "object"
    },
    "exposure": {
      "type": "object"
    },
    "metric": {
      "enum": [
        "click_through",
        "chapter_continue",
        "day_retention",
        "chapter_retention",
        "comment_rate",
        "favorite_rate",
        "vote_rate"
      ]
    },
    "value": {
      "type": "number"
    },
    "window": {
      "type": "object"
    },
    "event_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}