{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/authorization-decision.schema.json",
  "title": "AuthorizationDecision",
  "type": "object",
  "required": [
    "decision_id",
    "actor_ref",
    "action",
    "resource_ref",
    "decision",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource_ref": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "reason": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}