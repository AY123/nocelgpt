{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/incident-record.schema.json",
  "title": "IncidentRecord",
  "type": "object",
  "required": [
    "incident_id",
    "severity",
    "status",
    "summary",
    "detected_at",
    "affected_scope",
    "timeline"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "status": {
      "enum": [
        "DETECTED",
        "TRIAGED",
        "CONTAINED",
        "MITIGATED",
        "RECOVERED",
        "POSTMORTEM",
        "CLOSED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "affected_scope": {
      "type": "object"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "containment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recovery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corrective_actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "owner_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}