{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "audit_id",
    "actor_ref",
    "action",
    "resource_ref",
    "result",
    "created_at"
  ],
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "actor_ref": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource_ref": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bound_hashes": {
      "type": "object"
    },
    "result": {
      "enum": [
        "SUCCESS",
        "DENIED",
        "FAILED"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_audit_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}