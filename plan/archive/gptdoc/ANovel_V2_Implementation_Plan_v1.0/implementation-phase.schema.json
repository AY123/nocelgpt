{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/implementation-phase.schema.json",
  "title": "ImplementationPhase",
  "type": "object",
  "required": [
    "phase_id",
    "name",
    "goal",
    "dependencies",
    "deliverables",
    "exit_gate",
    "status"
  ],
  "properties": {
    "phase_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_gate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "BLOCKED",
        "VERIFIED",
        "CLOSED"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}