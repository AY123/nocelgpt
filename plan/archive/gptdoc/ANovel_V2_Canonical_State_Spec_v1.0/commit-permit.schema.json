{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/commit-permit.schema.json",
  "title": "CommitPermit",
  "type": "object",
  "required": [
    "permit_id",
    "project_id",
    "branch_id",
    "change_set_hash",
    "source_text_hash",
    "expected_parent_hash",
    "contract_hash",
    "genre_pack_hash",
    "policy_hash",
    "decision",
    "validation_refs"
  ],
  "properties": {
    "permit_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "change_set_hash": {
      "type": "string"
    },
    "source_text_hash": {
      "type": "string"
    },
    "expected_parent_hash": {
      "type": "string"
    },
    "contract_hash": {
      "type": "string"
    },
    "genre_pack_hash": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REPAIR_REQUIRED",
        "HUMAN_REVIEW"
      ]
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}