{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/canon-transaction.schema.json",
  "title": "CanonTransactionRecord",
  "type": "object",
  "required": [
    "transaction_id",
    "project_id",
    "branch_id",
    "expected_parent_commit_id",
    "state",
    "steps"
  ],
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "expected_parent_commit_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "STARTED",
        "VALIDATING",
        "PERMIT_READY",
        "COMMITTING",
        "COMMITTED",
        "ROLLED_BACK",
        "FAILED"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "change_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "permit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "commit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}