{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/retcon-request.schema.json",
  "title": "RetconRequest",
  "type": "object",
  "required": [
    "retcon_id",
    "project_id",
    "branch_id",
    "retcon_type",
    "severity",
    "target_refs",
    "reason",
    "status"
  ],
  "properties": {
    "retcon_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "retcon_type": {
      "enum": [
        "CORRECTION",
        "CONTINUITY_REPAIR",
        "AUTHORIAL_CHANGE",
        "WORLD_RULE_CHANGE",
        "IDENTITY_CORRECTION"
      ]
    },
    "severity": {
      "enum": [
        "R1",
        "R2",
        "R3"
      ]
    },
    "target_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "impact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PROPOSED",
        "IMPACT_ANALYZED",
        "APPROVED",
        "REJECTED",
        "COMMITTED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}