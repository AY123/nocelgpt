{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/workflow-run.schema.json",
  "title": "WorkflowRun",
  "type": "object",
  "required": [
    "run_id",
    "project_id",
    "branch_id",
    "workflow_id",
    "workflow_version",
    "run_type",
    "status",
    "run_fingerprint",
    "input_refs"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "workflow_version": {
      "type": "string"
    },
    "run_type": {
      "enum": [
        "GENESIS",
        "PLAN",
        "CHAPTER_PRODUCTION",
        "SCENE_REPAIR",
        "RETCON",
        "REBUILD",
        "CERTIFICATION",
        "PUBLISH"
      ]
    },
    "status": {
      "enum": [
        "CREATED",
        "READY",
        "RUNNING",
        "PAUSED",
        "BLOCKED",
        "WAITING_HUMAN",
        "WAITING_EXTERNAL",
        "SUCCEEDED",
        "FAILED",
        "ABORTED",
        "CANCELLED"
      ]
    },
    "run_fingerprint": {
      "type": "string"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}