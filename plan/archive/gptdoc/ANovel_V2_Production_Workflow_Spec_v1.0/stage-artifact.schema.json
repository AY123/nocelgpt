{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/stage-artifact.schema.json",
  "title": "StageArtifact",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "run_id",
    "stage_id",
    "attempt",
    "content_hash",
    "schema_version",
    "provenance"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "payload_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}