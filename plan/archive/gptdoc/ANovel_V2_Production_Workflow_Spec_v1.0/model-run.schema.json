{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/model-run.schema.json",
  "title": "ModelRun",
  "type": "object",
  "required": [
    "model_run_id",
    "run_id",
    "stage_id",
    "semantic_request_fingerprint",
    "actual_provider",
    "actual_model",
    "context_hash",
    "prompt_template_hash",
    "response_hash",
    "status"
  ],
  "properties": {
    "model_run_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "semantic_request_fingerprint": {
      "type": "string"
    },
    "actual_provider": {
      "type": "string"
    },
    "actual_model": {
      "type": "string"
    },
    "context_hash": {
      "type": "string"
    },
    "prompt_template_hash": {
      "type": "string"
    },
    "response_hash": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CACHED"
      ]
    },
    "usage": {
      "type": "object"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "retry_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}