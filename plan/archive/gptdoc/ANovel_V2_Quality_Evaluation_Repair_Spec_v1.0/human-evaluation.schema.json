{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/human-evaluation.schema.json",
  "title": "HumanEvaluation",
  "type": "object",
  "required": [
    "evaluation_id",
    "sample_ref",
    "reviewer_ref",
    "blind",
    "dimensions",
    "overall_preference",
    "confidence"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string"
    },
    "sample_ref": {
      "type": "string"
    },
    "reviewer_ref": {
      "type": "string"
    },
    "blind": {
      "type": "boolean"
    },
    "reviewer_profile": {
      "type": "object"
    },
    "dimensions": {
      "type": "object"
    },
    "overall_preference": {
      "type": [
        "string",
        "null"
      ]
    },
    "continuation_intent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}