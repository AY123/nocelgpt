{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/repair-plan.schema.json",
  "title": "RepairPlan",
  "type": "object",
  "required": [
    "repair_plan_id",
    "candidate_id",
    "candidate_hash",
    "finding_refs",
    "patch_scope",
    "must_preserve",
    "must_change",
    "must_not_introduce",
    "validation_rerun"
  ],
  "properties": {
    "repair_plan_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string"
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "patch_scope": {
      "enum": [
        "LOCAL",
        "PARAGRAPH",
        "SCENE",
        "CHAPTER_STRUCTURE",
        "WHOLE_CHAPTER_REWRITE"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "must_preserve": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "must_change": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "must_not_introduce": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allowed_delta": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protected_fact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_rerun": {
      "type": "array",
      "items": {
        "enum": [
          "Q0",
          "Q1",
          "Q2",
          "Q3",
          "Q4",
          "Q5",
          "Q6",
          "Q7"
        ]
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}