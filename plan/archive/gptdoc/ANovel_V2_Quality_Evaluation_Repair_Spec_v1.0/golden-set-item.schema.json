{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/golden-set-item.schema.json",
  "title": "GoldenSetItem",
  "type": "object",
  "required": [
    "sample_id",
    "task",
    "content_ref",
    "labels",
    "label_authority",
    "source_rights",
    "provenance"
  ],
  "properties": {
    "sample_id": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "label_authority": {
      "enum": [
        "HUMAN_GOLD",
        "EXPERT_GOLD",
        "PLATFORM_FACT",
        "AI_PROVISIONAL"
      ]
    },
    "human_evaluations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_rights": {
      "type": "object"
    },
    "split": {
      "enum": [
        "TUNE",
        "VALIDATION",
        "HOLDOUT"
      ]
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}