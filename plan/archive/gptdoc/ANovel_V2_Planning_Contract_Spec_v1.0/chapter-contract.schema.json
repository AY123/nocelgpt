{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/chapter-contract.schema.json",
  "title": "ChapterContract",
  "type": "object",
  "required": [
    "contract_id",
    "project_id",
    "chapter_id",
    "canon_parent_hash",
    "genre_pack_hash",
    "story_contract_ref",
    "arc_contract_ref",
    "chapter_plan_ref",
    "required_transitions",
    "forbidden_transitions",
    "protected_facts",
    "scene_contract_refs",
    "contract_hash"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "chapter_id": {
      "type": "string"
    },
    "canon_parent_hash": {
      "type": "string"
    },
    "genre_pack_hash": {
      "type": "string"
    },
    "story_contract_ref": {
      "type": "string"
    },
    "arc_contract_ref": {
      "type": "string"
    },
    "chapter_plan_ref": {
      "type": "string"
    },
    "chapter_function": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reader_goal": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forbidden_transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protected_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "required_entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "progression_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "promise_obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "payoff_obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hook_requirement": {
      "type": [
        "object",
        "null"
      ]
    },
    "tone_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scene_contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_hash": {
      "type": "string"
    },
    "compiler_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}