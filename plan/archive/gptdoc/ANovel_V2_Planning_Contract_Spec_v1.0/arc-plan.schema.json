{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/arc-plan.schema.json",
  "title": "ArcPlan",
  "type": "object",
  "required": [
    "id",
    "parent_ref",
    "canon_parent_hash",
    "arc_goal",
    "entry_state",
    "required_end_state",
    "conflict_engine",
    "status",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "parent_ref": {
      "type": "string"
    },
    "canon_parent_hash": {
      "type": "string"
    },
    "arc_goal": {
      "type": "string"
    },
    "entry_state": {
      "type": "object"
    },
    "required_end_state": {
      "type": "object"
    },
    "conflict_engine": {
      "type": "string"
    },
    "character_intents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "promise_open": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "promise_pay": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "progression": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected_reversals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failure_conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "FROZEN",
        "SUPERSEDED",
        "INVALIDATED",
        "COMPLETED"
      ]
    },
    "version": {
      "type": "string"
    },
    "input_hashes": {
      "type": "object"
    }
  },
  "additionalProperties": false
}