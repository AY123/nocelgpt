{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/scene-contract.schema.json",
  "title": "SceneContract",
  "type": "object",
  "required": [
    "contract_id",
    "scene_id",
    "parent_chapter_id",
    "canon_parent_hash",
    "entry_state_ref",
    "participants",
    "scene_goal",
    "required_transitions",
    "forbidden_transitions",
    "protected_facts",
    "knowledge_boundary",
    "contract_hash"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "parent_chapter_id": {
      "type": "string"
    },
    "canon_parent_hash": {
      "type": "string"
    },
    "entry_state_ref": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_goal": {
      "type": "string"
    },
    "conflict": {
      "type": [
        "object",
        "null"
      ]
    },
    "character_intents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "required_transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forbidden_transitions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protected_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allowed_extra": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_required_extra": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "knowledge_boundary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "capability_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exit_expectation": {
      "type": "object"
    },
    "contract_hash": {
      "type": "string"
    },
    "compiler_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}