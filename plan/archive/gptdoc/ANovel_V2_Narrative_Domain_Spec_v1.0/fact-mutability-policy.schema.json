{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/fact-mutability-policy.schema.json",
  "title": "FactMutabilityPolicy",
  "type": "object",
  "required": [
    "predicate",
    "mutability",
    "transition_policy"
  ],
  "properties": {
    "predicate": {
      "type": "string"
    },
    "mutability": {
      "enum": [
        "IMMUTABLE",
        "SLOW_MUTABLE",
        "DYNAMIC",
        "DERIVED"
      ]
    },
    "transition_policy": {
      "enum": [
        "retcon_only",
        "event_required",
        "free_with_evidence",
        "derived_only"
      ]
    },
    "validator_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}