{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/model-policy.schema.json",
  "title": "ModelPolicy",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "role_routes"
  ],
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "role_routes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "required_capabilities",
          "preferred_models"
        ],
        "properties": {
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preferred_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sampling": {
            "type": "object"
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "budget_class": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}