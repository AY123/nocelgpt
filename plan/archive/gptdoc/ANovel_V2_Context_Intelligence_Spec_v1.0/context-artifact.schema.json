{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/context-artifact.schema.json",
  "title": "ContextArtifact",
  "type": "object",
  "required": [
    "context_id",
    "project_id",
    "branch_id",
    "task_role",
    "task_id",
    "canon_head_hash",
    "contract_hash",
    "genre_pack_hash",
    "items",
    "token_budget",
    "selection_policy_version",
    "context_hash"
  ],
  "properties": {
    "context_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "task_role": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "canon_head_hash": {
      "type": "string"
    },
    "contract_hash": {
      "type": "string"
    },
    "genre_pack_hash": {
      "type": "string"
    },
    "planning_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "context-item.schema.json"
      }
    },
    "omitted_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "token_budget": {
      "$ref": "context-budget.schema.json"
    },
    "selection_policy_version": {
      "type": "string"
    },
    "prompt_template_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_policy_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_hash": {
      "type": "string"
    },
    "status": {
      "enum": [
        "REQUESTED",
        "COMPILED",
        "VALIDATED",
        "USED",
        "STALE",
        "INVALIDATED",
        "ARCHIVED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}