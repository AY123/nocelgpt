{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/genesis-candidate.schema.json",
  "title": "GenesisCandidate",
  "type": "object",
  "required": [
    "candidate_id",
    "premise",
    "genre_profile",
    "core_fantasy",
    "reader_promises",
    "narrative_engines",
    "progression_engines",
    "world_model",
    "character_architecture",
    "long_run_expansion"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "premise": {
      "type": "string"
    },
    "genre_profile": {
      "type": "object"
    },
    "core_fantasy": {
      "type": "string"
    },
    "reader_promises": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "narrative_engines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "progression_engines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflict_engines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "world_model": {
      "type": "object"
    },
    "character_architecture": {
      "type": "object"
    },
    "commercial_thesis": {
      "type": "object"
    },
    "long_run_expansion": {
      "type": "object"
    },
    "reference_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_report": {
      "type": "object"
    },
    "originality_report_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}