{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/reference-evidence-pack.schema.json",
  "title": "ReferenceEvidencePack",
  "type": "object",
  "required": [
    "pack_id",
    "source_profiles",
    "patterns",
    "negative_patterns",
    "conflicts",
    "authority",
    "provenance"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "source_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "dimension",
          "pattern",
          "confidence",
          "source_refs",
          "transferability",
          "originality_risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "pattern": {
            "type": "object"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_count": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_level": {
            "type": "string"
          },
          "transferability": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "originality_risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "negative_patterns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "authority": {
      "const": "reference"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}