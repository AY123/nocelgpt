{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/genesis-tournament.schema.json",
  "title": "GenesisTournamentReport",
  "type": "object",
  "required": [
    "tournament_id",
    "candidate_ids",
    "evaluations",
    "shortlist",
    "selection_policy"
  ],
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diversity_report": {
      "type": "object"
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_policy": {
      "type": "string"
    },
    "human_selection_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}