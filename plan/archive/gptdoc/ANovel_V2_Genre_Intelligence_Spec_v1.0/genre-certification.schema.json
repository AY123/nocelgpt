{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/genre-certification.schema.json",
  "title": "ANovel Genre Certification Report",
  "type": "object",
  "required": [
    "genre_pack_id",
    "genre_pack_version",
    "level",
    "status",
    "metrics",
    "cases"
  ],
  "properties": {
    "genre_pack_id": {
      "type": "string"
    },
    "genre_pack_version": {
      "type": "string"
    },
    "level": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "C4",
        "C5",
        "C6",
        "C7",
        "C8"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "hard_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "soft_violation_rate": {
          "type": "number",
          "minimum": 0
        },
        "genre_drift_rate": {
          "type": "number",
          "minimum": 0
        },
        "cross_genre_contamination": {
          "type": "integer",
          "minimum": 0
        },
        "canon_extension_error": {
          "type": "integer",
          "minimum": 0
        },
        "repair_rate": {
          "type": "number",
          "minimum": 0
        },
        "human_genre_fidelity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "engine_repetition_rate": {
          "type": "number",
          "minimum": 0
        },
        "progression_violation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}