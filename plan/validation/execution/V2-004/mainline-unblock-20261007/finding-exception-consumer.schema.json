{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned secret-exception consumer configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "ledger_ref",
    "ledger_sha256",
    "trusted_authorities"
  ],
  "properties": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_path"
      ],
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "project_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$"
        }
      }
    },
    "ledger_ref": {
      "type": "string",
      "minLength": 1
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "revision",
          "blob_oid",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "blob_oid": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
