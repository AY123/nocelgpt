{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact bounded authority approval or pending input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "authority_id",
    "actor",
    "role",
    "repository",
    "decision",
    "approved_at",
    "expires_at",
    "reason",
    "approved_ledger_sha256",
    "approval_kind",
    "finding_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "secret_exception_authority"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,200}$"
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "PROJECT_OWNER",
        "SECURITY_APPROVER"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_path"
      ],
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "project_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$"
        }
      }
    },
    "decision": {
      "enum": [
        "PENDING",
        "APPROVED"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "approved_ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_kind": {
      "enum": [
        "PRECISE_EXCEPTION",
        "OWNER_RISK_ACCEPTANCE"
      ]
    },
    "finding_identity_sha256": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
