{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anovel.ai/schemas/character.schema.json",
  "title": "Character",
  "description": "Character aggregate with knowledge, goals, intents, and planned actions. Contains BASE fields only per ADR-002.",
  "type": "object",
  "required": [
    "entity_id",
    "project_id",
    "lifecycle",
    "knowledge",
    "goals",
    "intents",
    "planned_actions",
    "created_at",
    "updated_at",
    "authority",
    "provenance"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "description": "Stable entity identifier from V2-005",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "description": "Project scope identifier"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["PLANNED", "ACTIVE", "INACTIVE", "DECEASED", "SUPERSEDED"],
      "description": "Character lifecycle state per frozen V2-061 Contract"
    },
    "knowledge": {
      "type": "object",
      "description": "Map of PropositionId to CharacterKnowledge (BASE fields only)",
      "additionalProperties": {
        "$ref": "#/$defs/CharacterKnowledge"
      }
    },
    "goals": {
      "type": "array",
      "description": "Character goals",
      "items": {
        "$ref": "#/$defs/Goal"
      }
    },
    "intents": {
      "type": "array",
      "description": "Character intents",
      "items": {
        "$ref": "#/$defs/Intent"
      }
    },
    "planned_actions": {
      "type": "array",
      "description": "Planned actions",
      "items": {
        "$ref": "#/$defs/PlannedAction"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "authority": {
      "type": "string",
      "description": "Authority source for this character state"
    },
    "provenance": {
      "type": "object",
      "description": "Structured provenance metadata per frozen Contract line 206",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Proposition": {
      "type": "object",
      "description": "Proposition BASE fields only",
      "required": [
        "proposition_id",
        "project_id",
        "subject",
        "predicate"
      ],
      "properties": {
        "proposition_id": {
          "type": "string",
          "description": "Unique proposition identifier (UUID v4 format)",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "description": "Project scope"
        },
        "subject": {
          "type": "string",
          "description": "Entity this proposition is about"
        },
        "predicate": {
          "type": "string",
          "description": "What is claimed"
        },
        "object": {
          "type": ["string", "null"],
          "description": "Optional target entity or value"
        },
        "context": {
          "type": ["object", "null"],
          "description": "Optional structured metadata"
        }
      },
      "additionalProperties": false
    },
    "CharacterKnowledge": {
      "type": "object",
      "description": "Character knowledge BASE fields only (aligns_with_fact CACHE field excluded)",
      "required": [
        "knower",
        "proposition",
        "knowledge_level",
        "acquisition_source"
      ],
      "properties": {
        "knower": {
          "type": "string",
          "description": "Character who holds this knowledge"
        },
        "proposition": {
          "$ref": "#/$defs/Proposition"
        },
        "knowledge_level": {
          "type": "string",
          "enum": ["KNOWN", "BELIEVED", "SUSPECTED"],
          "description": "Character's epistemic state per frozen V2-061 Contract"
        },
        "acquisition_source": {
          "type": "string",
          "enum": ["DIRECT_OBSERVATION", "COMMUNICATION", "DOCUMENT", "INFERENCE", "RUMOR"],
          "description": "How knowledge was acquired per frozen V2-061 Contract"
        },
        "source_character": {
          "type": ["string", "null"],
          "description": "Entity from whom knowledge was acquired (required for told_by)"
        },
        "source_ref": {
          "type": ["string", "null"],
          "description": "Reference to source event/scene"
        },
        "basis_ref": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          },
          "description": "List of PropositionIds reasoned from (for INFERENCE, non-empty required)"
        },
        "acquired_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "System timestamp of knowledge acquisition"
        },
        "story_time_ref": {
          "type": ["string", "null"],
          "description": "Narrative time reference"
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Character's confidence level"
        }
      },
      "additionalProperties": false
    },
    "Goal": {
      "type": "object",
      "description": "Character goal BASE fields",
      "required": [
        "goal_id",
        "character",
        "description",
        "status",
        "priority",
        "formed_at"
      ],
      "properties": {
        "goal_id": {
          "type": "string",
          "description": "Unique goal identifier (UUID v4 format)",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "character": {
          "type": "string",
          "description": "Character who holds this goal"
        },
        "description": {
          "type": "string",
          "description": "Natural language goal description"
        },
        "target_state": {
          "type": ["object", "null"],
          "description": "Desired outcome representation"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "BLOCKED", "ACHIEVED", "FAILED", "ABANDONED", "SUPERSEDED"],
          "description": "Goal pursuit status per frozen V2-061 Contract (AC-4)"
        },
        "priority": {
          "type": ["integer", "null"],
          "description": "Relative priority (higher = more important). Optional per frozen V2-061 Contract."
        },
        "formed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When goal was formed. Optional per frozen V2-061 Contract."
        },
        "resolved_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When goal was achieved/abandoned"
        }
      },
      "additionalProperties": false
    },
    "Intent": {
      "type": "object",
      "description": "Character intent BASE fields",
      "required": [
        "intent_id",
        "character",
        "description",
        "formed_at"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "description": "Unique intent identifier (UUID v4 format)",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "character": {
          "type": "string",
          "description": "Character who holds this intent"
        },
        "goal_ref": {
          "type": ["string", "null"],
          "description": "Reference to related goal"
        },
        "description": {
          "type": "string",
          "description": "Natural language intent description"
        },
        "formed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When intent was formed. Optional per frozen V2-061 Contract."
        },
        "abandoned_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When intent was abandoned"
        }
      },
      "additionalProperties": false
    },
    "PlannedAction": {
      "type": "object",
      "description": "Planned action BASE fields. occurred_event_ref is reference, not occurrence authority.",
      "required": [
        "action_id",
        "character",
        "action_description",
        "status",
        "created_at"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "description": "Unique action identifier (UUID v4 format)",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "character": {
          "type": "string",
          "description": "Character planning this action"
        },
        "action_description": {
          "type": "string",
          "description": "Natural language action description"
        },
        "intent_ref": {
          "type": ["string", "null"],
          "description": "Reference to related intent"
        },
        "planned_for": {
          "type": ["string", "null"],
          "description": "When action is planned to occur"
        },
        "status": {
          "type": "string",
          "enum": ["PLANNED", "CANCELLED"],
          "description": "Action status per frozen V2-061 Contract (AC-3). V2-061 owns PLANNED/CANCELLED only. V2-007 owns occurrence."
        },
        "occurred_event_ref": {
          "type": ["string", "null"],
          "description": "Reference to event if action occurred (not occurrence authority)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When action was planned"
        },
        "cancelled_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When action was cancelled"
        }
      },
      "additionalProperties": false
    }
  }
}
