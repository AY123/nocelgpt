{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/promises.schema.json",
  "title": "Evidence-bound reader-facing narrative promise",
  "description": "Structural contract only. Terminal restoration additionally requires the registered same-project Timeline and full event-content identity.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "id",
    "description",
    "opened_at",
    "window",
    "related_entities",
    "evidence_ref",
    "status",
    "resolution_event",
    "resolution_evidence_ref"
  ],
  "properties": {
    "kind": {
      "const": "PROMISE"
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/entity_id"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "opened_at": {
      "$ref": "#/$defs/narrative_position"
    },
    "window": {
      "$ref": "#/$defs/promise_window"
    },
    "related_entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity_id"
      },
      "uniqueItems": true
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "PAID",
        "BROKEN",
        "ABANDONED"
      ]
    },
    "resolution_event": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/event"
        }
      ]
    },
    "resolution_evidence_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "OPEN"
        },
        "resolution_event": {
          "type": "null"
        },
        "resolution_evidence_ref": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "PAID",
            "BROKEN"
          ]
        },
        "resolution_event": {
          "allOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "properties": {
                "occurrence": {
                  "const": "OCCURRED"
                }
              }
            }
          ]
        },
        "resolution_evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "ABANDONED"
        },
        "resolution_event": {
          "type": "null"
        },
        "resolution_evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "$defs": {
    "entity_id": {
      "type": "object",
      "description": "Stable entity identifier scoped to project",
      "required": [
        "project",
        "local_id"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Project scope identifier"
        },
        "local_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$",
          "description": "Unique identifier within project"
        }
      },
      "additionalProperties": false
    },
    "narrative_position": {
      "type": "object",
      "required": [
        "chapter",
        "order"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "story_time": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "earliest",
            "latest"
          ],
          "properties": {
            "kind": {
              "const": "UNKNOWN"
            },
            "earliest": {
              "type": "null"
            },
            "latest": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "earliest",
            "latest"
          ],
          "properties": {
            "kind": {
              "const": "EXACT"
            },
            "earliest": {
              "type": "integer"
            },
            "latest": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "earliest",
            "latest"
          ],
          "properties": {
            "kind": {
              "const": "RANGE"
            },
            "earliest": {
              "type": "integer"
            },
            "latest": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Project-local logical instant or possible-instant range; cross-field bound ordering is validated by the domain parser."
    },
    "event": {
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "id",
        "event_type",
        "narrative_position",
        "story_time",
        "occurrence",
        "evidence_ref",
        "description",
        "participants",
        "location"
      ],
      "properties": {
        "kind": {
          "const": "EVENT"
        },
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "$ref": "#/$defs/entity_id"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "narrative_position": {
          "$ref": "#/$defs/narrative_position"
        },
        "story_time": {
          "$ref": "#/$defs/story_time"
        },
        "occurrence": {
          "enum": [
            "OCCURRED",
            "NOT_OCCURRED",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_id"
          },
          "uniqueItems": true
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/entity_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": [
        "schema_version",
        "project",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/]+$"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "promise_window": {
      "description": "Inclusive narrative-position window. Bound ordering and opening alignment are enforced by the domain parser.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "UNKNOWN"
            },
            "start": {
              "type": "null"
            },
            "end": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "KNOWN"
            },
            "start": {
              "$ref": "#/$defs/narrative_position"
            },
            "end": {
              "$ref": "#/$defs/narrative_position"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
