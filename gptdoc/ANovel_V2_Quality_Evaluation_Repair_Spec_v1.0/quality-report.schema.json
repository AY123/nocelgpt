{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/quality-report.schema.json",
  "title": "QualityReport",
  "type": "object",
  "required": [
    "report_id",
    "candidate_id",
    "candidate_hash",
    "context_hash",
    "contract_hash",
    "quality_policy_version",
    "layers",
    "decision"
  ],
  "properties": {
    "report_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string"
    },
    "context_hash": {
      "type": "string"
    },
    "contract_hash": {
      "type": "string"
    },
    "quality_policy_version": {
      "type": "string"
    },
    "layers": {
      "type": "object",
      "properties": {
        "Q0": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q1": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q2": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q3": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q4": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q5": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q6": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        },
        "Q7": {
          "type": "array",
          "items": {
            "$ref": "evidence-record.schema.json"
          }
        }
      },
      "required": [
        "Q0",
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "Q5",
        "Q6",
        "Q7"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "PASS",
        "REPAIR_REQUIRED",
        "HUMAN_REVIEW",
        "BLOCKED"
      ]
    },
    "decision_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}