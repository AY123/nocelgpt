{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/implementation-task.schema.json",
  "title": "ImplementationTask",
  "type": "object",
  "required": [
    "task_id",
    "title",
    "phase",
    "priority",
    "goal",
    "dependencies",
    "acceptance_criteria",
    "tests",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "goal": {
      "type": "string"
    },
    "normative_specs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "OPEN",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "VERIFIED",
        "CLOSED",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": false
}