{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/series-vision.schema.json",
  "title": "SeriesVision",
  "type": "object",
  "required": [
    "id",
    "genesis_spec_ref",
    "core_premise",
    "story_question",
    "core_fantasy",
    "reader_promises",
    "target_end_state",
    "major_phases",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "genesis_spec_ref": {
      "type": "string"
    },
    "core_premise": {
      "type": "string"
    },
    "story_question": {
      "type": "string"
    },
    "core_fantasy": {
      "type": "string"
    },
    "reader_promises": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_end_state": {
      "type": "object"
    },
    "protagonist_transformation": {
      "type": "object"
    },
    "world_transformation": {
      "type": "object"
    },
    "long_run_engines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "major_phases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "anti_failure_constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "FROZEN",
        "SUPERSEDED",
        "INVALIDATED",
        "COMPLETED"
      ]
    },
    "input_hashes": {
      "type": "object"
    }
  },
  "additionalProperties": false
}