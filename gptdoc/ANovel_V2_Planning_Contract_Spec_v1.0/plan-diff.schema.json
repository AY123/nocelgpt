{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/plan-diff.schema.json",
  "title": "PlanDiff",
  "type": "object",
  "required": [
    "diff_id",
    "old_plan_ref",
    "new_plan_ref",
    "reason",
    "added",
    "removed",
    "modified",
    "preserved",
    "affected_artifacts"
  ],
  "properties": {
    "diff_id": {
      "type": "string"
    },
    "old_plan_ref": {
      "type": "string"
    },
    "new_plan_ref": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "modified": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preserved": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}