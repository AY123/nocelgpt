{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/budget-ledger.schema.json",
  "title": "BudgetLedger",
  "type": "object",
  "required": [
    "budget_id",
    "currency",
    "limits",
    "reserved",
    "actual"
  ],
  "properties": {
    "budget_id": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "limits": {
      "type": "object"
    },
    "reserved": {
      "type": "object"
    },
    "actual": {
      "type": "object"
    },
    "token_limits": {
      "type": "object"
    },
    "time_limits": {
      "type": "object"
    },
    "retry_limits": {
      "type": "object"
    },
    "status": {
      "enum": [
        "OPEN",
        "NEAR_LIMIT",
        "BLOCKED",
        "CLOSED"
      ]
    }
  },
  "additionalProperties": false
}