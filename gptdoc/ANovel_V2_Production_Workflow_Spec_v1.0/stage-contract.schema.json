{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/stage-contract.schema.json",
  "title": "StageContract",
  "type": "object",
  "required": [
    "stage_id",
    "stage_type",
    "stage_version",
    "input_artifact_refs",
    "input_hashes",
    "expected_output_types",
    "idempotency_key",
    "retry_policy",
    "side_effect_class",
    "checkpoint_required"
  ],
  "properties": {
    "stage_id": {
      "type": "string"
    },
    "stage_type": {
      "type": "string"
    },
    "stage_version": {
      "type": "string"
    },
    "input_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_hashes": {
      "type": "object"
    },
    "expected_output_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": "string"
    },
    "retry_policy": {
      "$ref": "retry-policy.schema.json"
    },
    "timeout_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "budget_reservation": {
      "type": [
        "object",
        "null"
      ]
    },
    "side_effect_class": {
      "enum": [
        "NONE",
        "MODEL_CALL",
        "DATABASE_COMMIT",
        "EXTERNAL_PUBLISH",
        "HUMAN_DECISION",
        "OTHER_EXTERNAL"
      ]
    },
    "checkpoint_required": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}