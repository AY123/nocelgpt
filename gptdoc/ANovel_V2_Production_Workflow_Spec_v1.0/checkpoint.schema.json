{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/checkpoint.schema.json",
  "title": "WorkflowCheckpoint",
  "type": "object",
  "required": [
    "checkpoint_id",
    "run_id",
    "stage_id",
    "attempt",
    "status",
    "input_hashes",
    "output_refs",
    "created_at"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "WAITING",
        "CANCELLED"
      ]
    },
    "input_hashes": {
      "type": "object"
    },
    "output_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "side_effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_state": {
      "type": "object"
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}