{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/relationship.schema.json",
  "title": "Relationship",
  "type": "object",
  "required": [
    "id",
    "party_a",
    "party_b",
    "types",
    "authority",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "party_a": {
      "type": "string"
    },
    "party_b": {
      "type": "string"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "trust": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "affection": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "loyalty": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "fear": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "dependency": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "hostility": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "public_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "private_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}