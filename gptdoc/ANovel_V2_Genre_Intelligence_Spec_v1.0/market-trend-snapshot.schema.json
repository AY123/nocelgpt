{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/market-trend-snapshot.schema.json",
  "title": "ANovel MarketTrendSnapshot",
  "type": "object",
  "required": [
    "id",
    "version",
    "platform",
    "channel",
    "period",
    "captured_at",
    "signals",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "confidence",
          "evidence_level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_level": {
            "enum": [
              "M0",
              "M1",
              "M2",
              "M3"
            ]
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "level": {
            "enum": [
              "M0",
              "M1",
              "M2",
              "M3"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}