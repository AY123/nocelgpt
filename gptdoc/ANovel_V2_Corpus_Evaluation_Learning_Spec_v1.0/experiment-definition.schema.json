{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/experiment-definition.schema.json",
  "title": "ExperimentDefinition",
  "type": "object",
  "required": [
    "experiment_id",
    "version",
    "hypothesis",
    "baseline",
    "variant",
    "dataset_ref",
    "primary_metrics",
    "guardrail_metrics",
    "success_criteria",
    "failure_criteria",
    "statistical_plan",
    "status"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "baseline": {
      "type": "object"
    },
    "variant": {
      "type": "object"
    },
    "dataset_ref": {
      "type": "string"
    },
    "sample_selection": {
      "type": "object"
    },
    "primary_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "secondary_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guardrail_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "object"
    },
    "failure_criteria": {
      "type": "object"
    },
    "statistical_plan": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "status": {
      "enum": [
        "DRAFT",
        "FROZEN",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "INVALIDATED",
        "ARCHIVED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}