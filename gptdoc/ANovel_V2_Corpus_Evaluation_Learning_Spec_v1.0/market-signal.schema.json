{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/market-signal.schema.json",
  "title": "MarketSignal",
  "type": "object",
  "required": [
    "signal_id",
    "platform",
    "content_ref",
    "metric",
    "value",
    "exposure",
    "period",
    "captured_at"
  ],
  "properties": {
    "signal_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "content_ref": {
      "type": "string"
    },
    "metric": {
      "enum": [
        "first_subscription",
        "average_subscription",
        "paid_follow",
        "revenue",
        "ranking",
        "monthly_votes",
        "conversion"
      ]
    },
    "value": {
      "type": "number"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "exposure": {
      "type": "object"
    },
    "period": {
      "type": "object"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}