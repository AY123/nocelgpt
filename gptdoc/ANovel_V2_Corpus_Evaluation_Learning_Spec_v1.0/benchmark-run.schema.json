{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/benchmark-run.schema.json",
  "title": "BenchmarkRun",
  "type": "object",
  "required": [
    "benchmark_run_id",
    "benchmark_id",
    "benchmark_version",
    "dataset_ref",
    "dataset_version",
    "config_fingerprint",
    "results",
    "status"
  ],
  "properties": {
    "benchmark_run_id": {
      "type": "string"
    },
    "benchmark_id": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "dataset_ref": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "config_fingerprint": {
      "type": "string"
    },
    "results": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "latency": {
      "type": "object"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "INVALIDATED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}