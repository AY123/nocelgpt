{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anovel.dev/schemas/canon-event.schema.json",
  "title": "CanonEvent",
  "type": "object",
  "required": [
    "event_id",
    "commit_id",
    "sequence",
    "event_type",
    "payload",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "commit_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "story_time": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}