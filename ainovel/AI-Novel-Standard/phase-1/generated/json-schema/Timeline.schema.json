{
  "$id": "anes:phase-1:Timeline",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A named time axis onto which events are placed.",
  "properties": {
    "branch_point": {
      "description": "event on the parent axis where this axis diverges",
      "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:EVT)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
      "type": "string"
    },
    "calendar": {
      "description": "name of the in-world calendar system this axis uses",
      "type": "string"
    },
    "fact_version": {
      "description": "Registry version of this record",
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "description": "permanent immutable identifier",
      "pattern": "^TML-\\d{5,}$",
      "type": "string"
    },
    "kind": {
      "description": "role of this axis (main / flashback / parallel / hypothetical)",
      "enum": [
        "main",
        "flashback",
        "parallel",
        "hypothetical"
      ],
      "type": "string"
    },
    "name": {
      "description": "mutable human label",
      "type": "string"
    },
    "notes": {
      "description": "free-text authoring notes; not a resolution source",
      "type": "string"
    },
    "ordering": {
      "default": "absolute",
      "description": "absolute = dated; relative = ordered only by sequence",
      "enum": [
        "absolute",
        "relative"
      ],
      "type": "string"
    },
    "parent_timeline": {
      "description": "axis this one branches from, for flashback/parallel lines",
      "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:TML)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
      "type": "string"
    },
    "status": {
      "default": "active",
      "description": "lifecycle state",
      "enum": [
        "active",
        "deprecated",
        "tombstoned"
      ],
      "type": "string"
    }
  },
  "required": [
    "fact_version",
    "id",
    "kind",
    "name"
  ],
  "title": "Timeline",
  "type": "object",
  "x-anes-generated": "DO NOT EDIT — generated from timeline.idl.yaml by tools/idl_to_jsonschema.py",
  "x-anes-idl-version": "1.0",
  "x-anes-type-code": "TML"
}
