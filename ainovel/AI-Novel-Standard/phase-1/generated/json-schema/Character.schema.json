{
  "$id": "anes:phase-1:Character",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A person or agent that exists in the story world.",
  "properties": {
    "abilities": {
      "description": "world-rule elements the character can use (declared, not inferred)",
      "items": {
        "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:MAG|TEC)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
        "type": "string"
      },
      "type": "array"
    },
    "affiliations": {
      "description": "factions/organizations the character belongs to",
      "items": {
        "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:FAC)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
        "type": "string"
      },
      "type": "array"
    },
    "age_facts": {
      "description": "asserted age AT specific events; never a derived 'is adult' inference",
      "items": {
        "additionalProperties": false,
        "properties": {
          "age": {
            "minimum": 0,
            "type": "integer"
          },
          "at_event": {
            "description": "reference point",
            "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:EVT)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
            "type": "string"
          }
        },
        "required": [
          "at_event",
          "age"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "aliases": {
      "description": "other names the character is known by; labels only, not IDs",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "arcs": {
      "description": "character/plot arcs this character participates in",
      "items": {
        "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:ARC)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
        "type": "string"
      },
      "type": "array"
    },
    "birth_event": {
      "description": "event marking birth/origin, if established",
      "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:EVT)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
      "type": "string"
    },
    "certainty": {
      "default": "canon",
      "enum": [
        "canon",
        "provisional",
        "contested"
      ],
      "type": "string"
    },
    "fact_version": {
      "description": "Registry version of this record",
      "minimum": 1,
      "type": "integer"
    },
    "id": {
      "description": "permanent immutable identifier",
      "pattern": "^CHR-\\d{5,}$",
      "type": "string"
    },
    "importance": {
      "description": "narrative weight of this character",
      "enum": [
        "minor",
        "supporting",
        "major",
        "central"
      ],
      "type": "string"
    },
    "locations_known": {
      "description": "locations canonically associated with the character",
      "items": {
        "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:LOC)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "description": "mutable human label",
      "type": "string"
    },
    "notes": {
      "description": "free-text authoring notes; not a resolution source",
      "type": "string"
    },
    "physical_facts": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "declared physical attributes as key->value facts (e.g. eye_color: green)",
      "type": "object"
    },
    "possessions": {
      "description": "items the character canonically holds",
      "items": {
        "pattern": "^(?:[a-z0-9-]{1,32}:)?(?:ITM)-\\d{5,}(?:#[A-Za-z0-9_.\\[\\]-]+)?(?:@(?:v\\d+|latest))?$",
        "type": "string"
      },
      "type": "array"
    },
    "status": {
      "default": "active",
      "description": "lifecycle state",
      "enum": [
        "active",
        "deprecated",
        "tombstoned"
      ],
      "type": "string"
    }
  },
  "required": [
    "fact_version",
    "id",
    "name"
  ],
  "title": "Character",
  "type": "object",
  "x-anes-generated": "DO NOT EDIT — generated from character.idl.yaml by tools/idl_to_jsonschema.py",
  "x-anes-idl-version": "1.0",
  "x-anes-type-code": "CHR"
}
