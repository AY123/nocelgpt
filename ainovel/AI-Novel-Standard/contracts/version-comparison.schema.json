{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:version-comparison:1.0",
  "title": "VersionComparison",
  "description": "Phase 6/7 director contract: a comparison of multiple draft versions of one chapter, scored and ranked so a selection can follow. The director does NOT invent a new scorer here — comparison is a thin adapter over existing advisory signals (Commercial Loop reader simulation, quality review); version scores are supplied by those signals, not computed by the director. This is a DERIVED production artifact, not a registry fact (ADR-006). Two structural invariants: `gating` const false (ADR-003) — a comparison NEVER blocks a build. `authority` const human (ADR-009) — selecting a version for INTERNAL production follows the Commercial Loop precedent (a reader-preferred draft may replace another), but no comparison auto-executes an outward/irreversible transition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "authority",
    "gating",
    "chapter_id",
    "versions",
    "winner",
    "selection_policy",
    "summary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CMP-\\d{5,}$" },
    "kind": { "type": "string", "const": "version_comparison" },
    "authority": {
      "type": "string",
      "const": "human",
      "description": "Structural invariant (ADR-009): internal draft selection may be automatic (Commercial Loop precedent); outward commitment stays human."
    },
    "gating": {
      "type": "boolean",
      "const": false,
      "description": "Structural invariant (ADR-003): a version comparison NEVER blocks a build. It is advisory ranking."
    },
    "schema_version": { "type": "string", "default": "1.0" },
    "chapter_id": { "type": "string", "minLength": 1 },
    "objective_ref": { "type": ["string", "null"] },
    "brief_ref": { "type": ["string", "null"] },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["version_id", "score"],
        "properties": {
          "version_id": { "type": "string", "minLength": 1 },
          "score": { "type": "number" },
          "reason": { "type": "string" }
        }
      }
    },
    "winner": { "type": ["string", "null"] },
    "selection_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary_metric": { "type": "string", "minLength": 1 },
        "secondary_metric": { "type": "string", "minLength": 1 },
        "tie_break": { "type": "string" }
      }
    },
    "selection_metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "winner_index": { "type": "integer" },
        "tie_break_applied": { "type": "boolean" },
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "version_id": { "type": "string" },
              "score": { "type": "number" },
              "input_index": { "type": "integer" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "headline": { "type": "string" },
        "major_change_rate_percent": { "type": "number" },
        "qa_score_deltas": { "type": "object", "additionalProperties": { "type": "number" } },
        "commercial_focus": { "type": ["string", "null"] },
        "recommendation": { "type": "string" },
        "editorial": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "readability": { "type": "string" },
            "retention": { "type": "string" },
            "market_fit": { "type": "string" },
            "editorial_verdict": { "type": "string" },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "risk_summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "risks": { "type": "array", "items": { "type": "string" } },
        "recovery_actions": { "type": "array", "items": { "type": "string" } },
        "verdict_shift": { "type": "array", "items": { "type": ["string", "null"] } }
      }
    },
    "pipeline_decision": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "advance_to_next_chapter": { "type": "boolean" },
        "trigger_revision_round": { "type": "boolean" },
        "hold_for_human_review": { "type": "boolean" },
        "action": { "type": "string" },
        "reasons": { "type": "object", "additionalProperties": true }
      }
    },
    "notes": { "type": "string" }
  }
}
