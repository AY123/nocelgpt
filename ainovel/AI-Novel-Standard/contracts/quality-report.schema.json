{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:quality-report:1.0",
  "title": "QualityReport",
  "description": "Output of the Novel Quality Center's EVALUATIVE axis (ADR-003). A per-chapter quality judgment produced by an LLM judge behind the DraftReviewer seam. It is ADVISORY: axis is const 'evaluative' and gating is const false — these are STRUCTURAL INVARIANTS enforced by schema, so a quality report can never gate a build no matter what a model returns. Scores are 0-100 on commercial/craft dimensions; predictive signals (subscription/retention) live under `predictions` and are explicitly marked non-gating and comparison-only. The report rides the Runtime envelope beside the draft (like execution.draft_review), never inside the frozen ChapterDraft schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewer", "axis", "gating", "scores", "dimensions"],
  "properties": {
    "reviewer": { "type": "string", "minLength": 1 },
    "axis": { "type": "string", "const": "evaluative" },
    "gating": { "type": "boolean", "const": false },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook",
        "conflict",
        "reward_density",
        "character_consistency",
        "world_consistency",
        "emotion",
        "commercial",
        "originality_risk"
      ],
      "properties": {
        "hook": { "type": "integer", "minimum": 0, "maximum": 100 },
        "conflict": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reward_density": { "type": "integer", "minimum": 0, "maximum": 100 },
        "character_consistency": { "type": "integer", "minimum": 0, "maximum": 100 },
        "world_consistency": { "type": "integer", "minimum": 0, "maximum": 100 },
        "emotion": { "type": "integer", "minimum": 0, "maximum": 100 },
        "commercial": { "type": "integer", "minimum": 0, "maximum": 100 },
        "originality_risk": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },

    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score"],
        "properties": {
          "name": { "type": "string" },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "evidence": { "type": "string" },
          "comment": { "type": "string" }
        }
      }
    },

    "revision_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "issue", "action"],
        "properties": {
          "dimension": { "type": "string" },
          "issue": { "type": "string" },
          "action": { "type": "string" },
          "evidence": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },

    "predictions": {
      "type": "object",
      "description": "PREDICTIVE signals. Never gate; use for RELATIVE comparison between revisions only, not as absolute truth (ADR-003).",
      "additionalProperties": false,
      "properties": {
        "gating": { "type": "boolean", "const": false },
        "comparison_only": { "type": "boolean", "const": true },
        "subscription": { "type": "integer", "minimum": 0, "maximum": 100 },
        "retention": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reader_satisfaction": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "severity", "message"],
        "properties": {
          "check": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string" }
        }
      }
    },

    "judge_provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model_id": { "type": "string" },
        "parse_ok": { "type": "boolean" },
        "degraded": { "type": "boolean" }
      }
    },

    "panel": {
      "type": "object",
      "description": "Present when this report is the SYNTHESIS of a multi-model review panel. Panelists score independently (no cross-reference); synthesis weights each on its specialty dimensions and surfaces disagreement rather than hiding it. The synthesized report is still a valid QualityReport (axis/gating invariants hold), so all consumers are unchanged.",
      "additionalProperties": false,
      "required": ["synthesis", "panelists"],
      "properties": {
        "synthesis": { "type": "string", "enum": ["weighted", "mean"] },
        "panelists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer", "role", "scores", "degraded"],
            "properties": {
              "reviewer": { "type": "string" },
              "role": { "type": "string" },
              "model_id": { "type": "string" },
              "degraded": { "type": "boolean" },
              "scores": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            }
          }
        },
        "disagreement": {
          "type": "object",
          "description": "Per-dimension spread (max-min) across non-degraded panelists. High spread = the panel disagrees; a human should look.",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
