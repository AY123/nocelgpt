{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMRequest",
  "type": "object",
  "required": [
    "request_id",
    "capability",
    "messages",
    "model_pin",
    "temperature",
    "timeout_seconds",
    "prompt_provenance"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^LLM-[a-f0-9]+$"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "model_pin": {
      "type": "object",
      "required": ["provider", "model", "adapter_version"],
      "properties": {
        "provider": {
          "enum": ["openai", "deepseek", "claude", "gemini", "kimi", "92code", "local", "mock"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "api_base": {
          "type": ["string", "null"]
        },
        "api_version": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "temperature": {
      "type": "object",
      "required": ["temperature"],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 600
    },
    "max_output_tokens": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "prompt_provenance": {
      "type": "object",
      "required": [
        "prompt_id",
        "prompt_hash",
        "package_hash",
        "derived_from",
        "rendered_at"
      ],
      "properties": {
        "prompt_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "template_id": {
          "type": ["string", "null"]
        },
        "template_version": {
          "type": ["string", "null"]
        },
        "package_hash": {
          "type": "string",
          "minLength": 1
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rendered_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
