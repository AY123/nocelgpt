{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMResponse",
  "type": "object",
  "required": [
    "request_id",
    "provider",
    "model",
    "text",
    "finish_reason",
    "token_usage",
    "cost",
    "latency_ms",
    "response_hash",
    "provider_request_id",
    "replay_ref"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^LLM-[a-f0-9]+$"
    },
    "provider": {
      "enum": ["openai", "deepseek", "claude", "gemini", "kimi", "92code", "local", "mock"]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "finish_reason": {
      "enum": ["stop", "length", "tool_call", "content_filter", "error"]
    },
    "token_usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "usage_estimated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cost": {
      "type": ["object", "null"],
      "properties": {
        "currency": {
          "type": "string"
        },
        "input_cost": {
          "type": "number"
        },
        "output_cost": {
          "type": "number"
        },
        "total_cost": {
          "type": "number"
        },
        "pricing_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "response_hash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "provider_request_id": {
      "type": ["string", "null"]
    },
    "replay_ref": {
      "type": ["string", "null"]
    },
    "attempts": {
      "type": "array",
      "description": "Per-provider attempt trail from the fallback client (runtime/llm/fallback.py): each entry records a provider tried and whether it succeeded or failed transiently before fallover. Empty for a single-provider request.",
      "items": {
        "type": "object",
        "required": ["provider", "status"],
        "properties": {
          "provider": { "type": "string" },
          "status": { "enum": ["ok", "transient_error"] },
          "error": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
