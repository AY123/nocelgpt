{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:consumption-ab-report:1.0",
  "title": "ConsumptionABReport",
  "description": "CI-M2-04: a deterministic two-arm report proving that approved new facts are consumed by the next chapter (N+1). Compares the same chapter generated WITH vs WITHOUT the approved facts and checks six criteria. Advisory read-side artifact: never gates, writes no facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "chapter_id", "consumption_hash", "mint_ids", "arm_without", "arm_with", "fact_reflection", "changed_historical_fact_ids", "replay_handles", "criteria", "all_criteria_met", "comparison_only", "gating", "report_hash"],
  "properties": {
    "kind": { "const": "consumption_ab_report" },
    "schema_version": { "const": "1.0" },
    "chapter_id": { "type": "string", "minLength": 1 },
    "consumption_hash": { "type": ["string", "null"] },
    "mint_ids": { "type": "array", "items": { "type": "string" } },
    "arm_without": { "$ref": "#/$defs/arm" },
    "arm_with": { "$ref": "#/$defs/arm" },
    "fact_reflection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "markers", "reflected"],
        "properties": {
          "fact_id": { "type": "string" },
          "markers": { "type": "array", "items": { "type": "string" } },
          "reflected": { "type": "boolean" }
        }
      }
    },
    "changed_historical_fact_ids": { "type": "array", "items": { "type": "string" } },
    "replay_handles": { "type": "object" },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_content_changed", "prompt_manifest_hash_changed", "draft_content_hash_changed", "historical_fact_hashes_unchanged", "approved_facts_reflected", "report_replayable"],
      "properties": {
        "prompt_content_changed": { "type": "boolean" },
        "prompt_manifest_hash_changed": { "type": "boolean" },
        "draft_content_hash_changed": { "type": "boolean" },
        "historical_fact_hashes_unchanged": { "type": "boolean" },
        "approved_facts_reflected": { "type": "boolean" },
        "report_replayable": { "type": "boolean" }
      }
    },
    "all_criteria_met": { "type": "boolean" },
    "comparison_only": { "const": true },
    "gating": { "const": false },
    "report_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_manifest_hash", "prompt_rendered_hash", "draft_content_hash"],
      "properties": {
        "prompt_manifest_hash": { "type": ["string", "null"] },
        "prompt_rendered_hash": { "type": ["string", "null"] },
        "draft_content_hash": { "type": ["string", "null"] }
      }
    }
  }
}
