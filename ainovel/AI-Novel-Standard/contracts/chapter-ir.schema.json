{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:chapter-ir:2.0",
  "title": "ChapterIR",
  "description": "A deterministic Chapter Narrative IR derived from outline intent and participants. It is the executable middle layer between outline and scene-plan, and now optionally carries a reference_anchor summary from the M5 reference abstraction so the chapter can align with the project's reusable market / structural thesis without copying specifics. COMPARISON-ONLY and never gates (ADR-003); writes only to registry/derived/ and never to facts or publish log.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_format", "kind", "chapter_no", "task_id", "beats", "provenance", "content_hash"],
  "properties": {
    "artifact_format": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "chapter_ir" },
    "chapter_no": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string" },
    "outline_ref": { "type": ["string", "null"] },
    "reference_anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "market_positioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "genre": { "type": "string" },
            "reader_target": { "type": "string" },
            "core_promise": { "type": "string" },
            "commercial_thesis": { "type": "string" }
          }
        },
        "structural_patterns": { "type": "object", "additionalProperties": { "type": "string" } },
        "commercial_cadence": { "type": "object", "additionalProperties": { "type": "string" } },
        "transferable_abstractions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "intent": { "type": ["string", "null"] },
    "dramatic_question": { "type": ["string", "null"] },
    "payoff_target": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["promise", "kind"],
      "properties": {
        "promise": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "reference_anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "market_positioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "genre": { "type": "string" },
            "reader_target": { "type": "string" },
            "core_promise": { "type": "string" },
            "commercial_thesis": { "type": "string" }
          }
        },
        "structural_patterns": { "type": "object", "additionalProperties": { "type": "string" } },
        "commercial_cadence": { "type": "object", "additionalProperties": { "type": "string" } },
        "transferable_abstractions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "role", "intent"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "role": { "type": "string" },
          "intent": { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string" } },
          "turning_point": { "type": "string" },
          "information_gain": { "type": "string" },
          "reader_question": { "type": "string" },
          "exit_hook": { "type": "string" },
          "emotion_shift": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": {
              "to": { "type": "integer" },
              "tone": { "type": "string" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from", "source_version"],
      "properties": {
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "source_version": { "type": "integer" }
      }
    },
    "content_hash": { "type": "string" }
  }
}
