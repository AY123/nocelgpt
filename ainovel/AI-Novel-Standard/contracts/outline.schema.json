{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:novel-outline:0.2",
  "title": "NovelOutline",
  "description": "Artifact Contract for the OUTPUT of the Outline Bootstrap workflow (v0.2). A novel outline is a DERIVED artifact (prose/design is not a fact): it is written to registry/derived/outline/, never to registry/facts/. It carries provenance pinning the reference sources and analysis it was synthesized from. The commercial-skeleton DSL (market_position, protagonist_engine, power_system, conflict_ladder, reward_loop, volume_plan, first_30_chapters, originality_delta) is what makes this outline a production input rather than a demo template.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "genre",
    "logline",
    "world",
    "characters",
    "plot",
    "collaboration",
    "originality_report",
    "provenance"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^OUTLINE-\\d{5,}$" },
    "kind": { "type": "string", "const": "novel_outline" },
    "schema_version": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "genre": { "type": "array", "items": { "type": "string" } },
    "genre_profile_id": { "type": "string" },
    "genre_contract_version": { "type": "string" },
    "logline": { "type": "string", "minLength": 1 },
    "themes": { "type": "array", "items": { "type": "string" } },
    "core_hook": { "type": "string" },

    "market_position": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "channel": { "type": "string" },
        "site_profile": { "type": "string" },
        "sub_genre": { "type": "string" },
        "reader_promise": { "type": "string" },
        "monetization_model": { "type": "string" },
        "update_cadence": { "type": "string" },
        "target_wordcount_per_chapter": { "type": "integer", "minimum": 0 },
        "competitor_refs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "protagonist_engine": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "desire": { "type": "string" },
        "flaw": { "type": "string" },
        "golden_finger": { "type": "string" },
        "cost": { "type": "string" }
      }
    },

    "power_system": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tiers": { "type": "array", "items": { "type": "string" } },
        "breakthrough_condition": { "type": "string" },
        "hard_limits": { "type": "array", "items": { "type": "string" } }
      }
    },

    "progression_system": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["power", "wealth", "tech", "influence"] },
        "tiers": { "type": "array", "items": { "type": "string" } },
        "breakthrough_condition": { "type": "string" },
        "hard_limits": { "type": "array", "items": { "type": "string" } }
      }
    },

    "conflict_ladder": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "level": { "type": "string" },
          "enemy": { "type": "string" },
          "pressure_source": { "type": "string" }
        }
      }
    },

    "reward_loop": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cadence_chapters": { "type": "integer", "minimum": 1 },
        "reward_types": { "type": "array", "items": { "type": "string" } }
      }
    },

    "world": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary", "rules"],
      "properties": {
        "summary": { "type": "string" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    },

    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "name"],
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string", "description": "The character's canonical setting name. If the prose uses a different rendering (a 译名/别称/简称 — e.g. setting name 'Edric Vance' but the chapter writes '埃德里克·万斯'), list those in `aliases`, or fact extraction cannot recognize the prose character as this entity and will propose it as a phantom new one." },
          "arc": { "type": "string" },
          "motivation": { "type": "string" },
          "abilities": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" }, "description": "Other names this character is known by — 译名/别称/简称, labels only, not IDs. Carried into the candidate fact record so downstream fact extraction can resolve a prose reference (often in a different language/rendering than the setting name) back to this entity instead of minting a duplicate." }
        }
      }
    },

    "plot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["main_arc", "volumes"],
      "properties": {
        "main_arc": { "type": "string" },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "title", "purpose"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "purpose": { "type": "string" },
              "map": { "type": "string" },
              "goal": { "type": "string" },
              "oppressor": { "type": "string" },
              "twist": { "type": "string" },
              "settlement": { "type": "string" }
            }
          }
        },
        "chapters": { "type": "array" }
      }
    },

    "first_30_chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["chapter_no", "end_hook"],
        "properties": {
          "chapter_no": { "type": "integer", "minimum": 1 },
          "goal": { "type": "string" },
          "conflict": { "type": "string" },
          "escalation": { "type": "string" },
          "reward_if_any": { "type": "string" },
          "end_hook": { "type": "string" }
        }
      }
    },

    "originality_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "axis": { "type": "string" },
          "reference_pattern": { "type": "string" },
          "our_variation": { "type": "string" }
        }
      }
    },

    "collaboration": {
      "type": "object",
      "additionalProperties": true,
      "required": ["selected_candidate"],
      "properties": {
        "agents": { "type": "array" },
        "selected_candidate": { "type": "string" },
        "reviews": { "type": "array" }
      }
    },

    "originality_report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["risk_level"],
      "properties": {
        "risk_level": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array" }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["project_id"],
      "properties": {
        "project_id": { "type": "string" },
        "reference_sources": { "type": "array" },
        "analysis_summary": { "type": "object" }
      }
    }
  }
}
