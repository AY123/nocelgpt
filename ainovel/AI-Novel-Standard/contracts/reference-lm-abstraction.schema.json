{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:reference-lm-abstraction:1.0",
  "title": "ReferenceLmAbstraction",
  "description": "A machine-consumable abstraction folded from 1-5 reference novels and their pinned quality profile. It captures reusable narrative, commercial, character, and world-structure patterns for downstream planning (Genesis / Long Arc / Narrative State). COMPARISON-ONLY and never gates (ADR-003): it informs generation and planning, never blocks a build. Written to registry/derived/reference-abstract/, never to registry/facts/ (ADR-006) and never the published log (ADR-009).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "kind", "source_ids", "market_positioning", "structural_patterns", "character_patterns", "world_patterns", "commercial_cadence", "transferable_abstractions", "prohibited_specifics", "evidence_spans"],
  "properties": {
    "id": { "type": "string", "pattern": "^REFABSTRACT-\\d{3,}$" },
    "schema_version": { "type": "string" },
    "kind": { "type": "string", "const": "reference_lm_abstraction" },
    "profile_id": { "type": ["string", "null"], "pattern": "^REFPROFILE-\\d{3,}$" },
    "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "market_positioning": {
      "type": "object",
      "required": ["genre", "reader_target", "core_promise", "commercial_thesis"],
      "additionalProperties": false,
      "properties": {
        "genre": { "type": "string" },
        "reader_target": { "type": "string" },
        "core_promise": { "type": "string" },
        "commercial_thesis": { "type": "string" }
      }
    },
    "structural_patterns": { "type": "object", "additionalProperties": { "type": "string" } },
    "character_patterns": {
      "type": "object",
      "required": ["protagonist", "supporting", "relationship"],
      "additionalProperties": false,
      "properties": {
        "protagonist": { "type": "string" },
        "supporting": { "type": "string" },
        "relationship": { "type": "string" }
      }
    },
    "world_patterns": {
      "type": "object",
      "required": ["rules", "progression", "constraints"],
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "string" },
        "progression": { "type": "string" },
        "constraints": { "type": "string" }
      }
    },
    "commercial_cadence": {
      "type": "object",
      "required": ["opening", "mid_arc", "chapter_end", "long_run"],
      "additionalProperties": false,
      "properties": {
        "opening": { "type": "string" },
        "mid_arc": { "type": "string" },
        "chapter_end": { "type": "string" },
        "long_run": { "type": "string" }
      }
    },
    "transferable_abstractions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "prohibited_specifics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "chapters_estimated", "dominant_function"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "chapters_estimated": { "type": "integer", "minimum": 0 },
          "dominant_function": { "type": "string" }
        }
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": { "type": "string" },
          "excerpt": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
