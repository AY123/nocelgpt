{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:long-arc-plan:1.0",
  "title": "LongArcPlan",
  "description": "Derived long-arc planning projection for a novel's 1-100 chapter structure. Advisory only, never gates (ADR-003); it informs chapter mandates and director objectives, never writes facts (ADR-006).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schema_version", "chapter_bands", "commercial_cadence", "map_change_conditions", "progression_ladders", "constraints", "provenance", "content_hash"],
  "properties": {
    "id": { "type": "string", "pattern": "^LONGARC-\\d{3,}$" },
    "kind": { "type": "string", "const": "long_arc_plan" },
    "schema_version": { "type": "string" },
    "chapter_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "goal", "commercial_goal", "map_change"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "commercial_goal": { "type": "string", "minLength": 1 },
          "map_change": { "type": "boolean" }
        }
      }
    },
    "commercial_cadence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["opening", "mid_arc", "chapter_end", "long_run"],
      "properties": {
        "opening": { "type": "string" },
        "mid_arc": { "type": "string" },
        "chapter_end": { "type": "string" },
        "long_run": { "type": "string" },
        "reader_promise": { "type": "string" },
        "brain_promise": { "type": "string" },
        "event_skeleton_count": { "type": "integer", "minimum": 0 }
      }
    },
    "map_change_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["band", "condition"],
        "properties": {
          "band": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    },
    "progression_ladders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "bands"],
        "properties": {
          "axis": { "type": "string" },
          "bands": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "provenance": { "type": "object", "additionalProperties": true },
    "content_hash": { "type": "string" }
  }
}
