{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:revision-session:1.0",
  "title": "RevisionSession",
  "description": "Record of a Revision Controller optimization loop over a single chapter draft. The controller takes a draft + its QualityReport.revision_plan, generates a targeted rewrite, re-scores it, and verifies the flagged dimensions actually improved — the machine-verifiable step that content_hash + replay make possible. This is an EVALUATIVE/optimization artifact: `gating` is const false — it never blocks a build. It rides the Runtime envelope beside the draft, never inside the frozen ChapterDraft schema. Deterministic gates still run on whichever draft the controller finally selects, via the normal execute path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "gating", "rounds", "terminate_reason", "verdict"],
  "properties": {
    "controller": { "type": "string", "minLength": 1 },
    "gating": { "type": "boolean", "const": false },
    "terminate_reason": {
      "type": "string",
      "enum": ["all_dimensions_pass", "converged", "no_improvement", "max_rounds", "budget_exhausted", "degraded"]
    },
    "verdict": {
      "type": "string",
      "enum": ["improved", "unchanged", "regressed", "degraded"]
    },
    "threshold": { "type": "integer", "minimum": 0, "maximum": 100 },
    "selected_draft_hash": { "type": "string" },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "draft_hash_before", "draft_hash_after", "targeted_dimensions", "scores_before", "scores_after"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "draft_hash_before": { "type": "string" },
          "draft_hash_after": { "type": "string" },
          "targeted_dimensions": { "type": "array", "items": { "type": "string" } },
          "scores_before": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "scores_after": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "improved": { "type": "array", "items": { "type": "string" } },
          "regressed": { "type": "array", "items": { "type": "string" } },
          "unchanged": { "type": "array", "items": { "type": "string" } },
          "degraded": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
