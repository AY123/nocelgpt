{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:book-profile-analysis-pass:1.0",
  "title": "BookProfileAnalysisPass",
  "description": "One independent, evidence-linked analysis pass used to build a BookNarrativeProfile. Contains abstractions and chapter references, never source prose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schema_version", "book_id", "corpus_snapshot_id", "corpus_manifest_hash", "pass_type", "status", "analysis", "findings", "evidence", "confidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^BPA-[0-9]{8}-(TOPDOWN|BOTTOMUP)$"},
    "kind": {"const": "book_profile_analysis_pass"},
    "schema_version": {"const": "1.0"},
    "book_id": {"type": "string", "pattern": "^CBK-[0-9]{8}$"},
    "corpus_snapshot_id": {"type": "string", "pattern": "^CORPUS-[A-Z0-9][A-Z0-9._-]{2,63}$"},
    "corpus_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pass_type": {"enum": ["top_down", "bottom_up"]},
    "status": {"enum": ["completed", "degraded"]},
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzer_version", "prompt_version", "model_policy_version"],
      "properties": {
        "analyzer_version": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "model_policy_version": {"type": "string", "minLength": 1}
      }
    },
    "findings": {
      "type": "object", "additionalProperties": false,
      "required": ["core_fantasy", "target_reader", "selling_point", "protagonist_deficit", "long_term_desire", "core_ability", "limitations", "growth_axes", "first_visible_payoff_chapter", "first_volume_promise", "sustainability_sources", "mid_stage_risks"],
      "properties": {
        "core_fantasy": {"type": "string"},
        "target_reader": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selling_point": {"type": "string"},
        "protagonist_deficit": {"type": "string"},
        "long_term_desire": {"type": "string"},
        "core_ability": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "growth_axes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "first_visible_payoff_chapter": {"type": ["integer", "null"], "minimum": 1},
        "first_volume_promise": {"type": "string"},
        "sustainability_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mid_stage_risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evidence": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "chapter_indexes", "feature_codes"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "chapter_indexes": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "feature_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "score", "limitations"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
