{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:market-snapshot:1.0",
  "title": "MarketSnapshot",
  "description": "A PINNED market-intelligence snapshot (Market DSL), not a live oracle. It is derived from dated market OBSERVATIONS the project supplies (ranking/trend text under sources/market-observations/), never from a real-time crawl — so it preserves the 'same input -> same output' reproducibility discipline. It carries fetched_at + source pins + a staleness marker; when it ages past its freshness window the system warns (ADVISORY, never gates) that the market judgment is old. Written to registry/derived/market/, NEVER to registry/facts/ (a market read is not a story fact). Its output feeds the outline's market_position as a versioned INPUT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "version", "fetched_at", "sources", "channels", "staleness"],
  "properties": {
    "id": { "type": "string", "pattern": "^MARKET-\\d{5,}$" },
    "kind": { "type": "string", "const": "market_snapshot" },
    "version": { "type": "string" },
    "fetched_at": { "type": "string", "description": "ISO-8601 date the observations were gathered; drives staleness." },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "filename", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "filename": { "type": "string" },
          "sha256": { "type": "string" },
          "platform": { "type": "string" }
        }
      }
    },
    "channels": {
      "type": "array",
      "description": "Per-channel (男频/女频) hot-genre readout with WHY, not just counts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "hot_genres"],
        "properties": {
          "channel": { "type": "string" },
          "hot_genres": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["genre"],
              "properties": {
                "genre": { "type": "string" },
                "heat": { "type": "integer", "minimum": 0, "maximum": 100 },
                "why_hot": { "type": "string" },
                "reader_promise": { "type": "string" },
                "drop_points": { "type": "array", "items": { "type": "string" } },
                "monetization_fit": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "signals": {
      "type": "object",
      "additionalProperties": true,
      "description": "Deterministic cross-channel aggregates (evidence-backed).",
      "properties": {
        "trending_genres": { "type": "array", "items": { "type": "string" } },
        "common_drop_points": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },

    "staleness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness_days", "is_stale"],
      "properties": {
        "freshness_days": { "type": "integer", "minimum": 1 },
        "age_days": { "type": "integer", "minimum": 0 },
        "is_stale": { "type": "boolean" },
        "gating": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "project_id": { "type": "string" },
        "analysis_summary": { "type": "object" }
      }
    }
  }
}
