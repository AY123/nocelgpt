{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:chapter-draft:1.0",
  "title": "ChapterDraft",
  "description": "Artifact Contract (ADR-002) for the OUTPUT of the ChapterDraft capability. A chapter draft is a DERIVED artifact (ADR-006: prose is not a fact). It carries provenance pinning the exact sources it was generated from, so staleness is detectable and it is never confused with the SSOT. It is NOT written into registry/facts/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_format",
    "kind",
    "capability",
    "task_id",
    "produced_by",
    "provenance",
    "body",
    "content_hash"
  ],
  "properties": {
    "artifact_format": { "type": "string", "const": "1.0" },
    "kind": { "type": "string", "const": "prose" },
    "capability": { "type": "string", "const": "ChapterDraft" },
    "task_id": { "type": "string", "pattern": "^TASK-\\d{5,}$" },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "model_kind"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "model_kind": { "type": "string", "enum": ["deterministic", "llm"] },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "provider",
            "model",
            "model_pin",
            "prompt_provenance",
            "token_usage",
            "latency_ms",
            "response_hash"
          ],
          "properties": {
            "request_id": { "type": "string", "pattern": "^LLM-[a-f0-9]+$" },
            "provider": { "enum": ["openai", "deepseek", "claude", "gemini", "kimi", "92code", "local", "mock"] },
            "model": { "type": "string", "minLength": 1 },
            "model_pin": {
              "type": "object",
              "required": ["provider", "model", "adapter_version"],
              "properties": {
                "provider": { "enum": ["openai", "deepseek", "claude", "gemini", "kimi", "92code", "local", "mock"] },
                "model": { "type": "string", "minLength": 1 },
                "adapter_version": { "type": "string", "minLength": 1 },
                "api_base": { "type": ["string", "null"] },
                "api_version": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            },
            "prompt_provenance": {
              "type": "object",
              "required": ["prompt_id", "prompt_hash", "package_hash", "derived_from", "rendered_at"],
              "properties": {
                "prompt_id": { "type": "string", "minLength": 1 },
                "prompt_hash": { "type": "string", "pattern": "^sha256:" },
                "template_id": { "type": ["string", "null"] },
                "template_version": { "type": ["string", "null"] },
                "package_hash": { "type": "string", "minLength": 1 },
                "derived_from": { "type": "array", "items": { "type": "string" } },
                "rendered_at": { "type": "string" }
              },
              "additionalProperties": false
            },
            "token_usage": {
              "type": "object",
              "required": ["input_tokens", "output_tokens", "total_tokens"],
              "properties": {
                "input_tokens": { "type": "integer", "minimum": 0 },
                "output_tokens": { "type": "integer", "minimum": 0 },
                "total_tokens": { "type": "integer", "minimum": 0 },
                "cached_input_tokens": { "type": "integer", "minimum": 0 },
                "reasoning_tokens": { "type": "integer", "minimum": 0 },
                "usage_estimated": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            "cost": { "type": ["object", "null"] },
            "latency_ms": { "type": "integer", "minimum": 0 },
            "response_hash": { "type": "string", "pattern": "^sha256:" },
            "provider_request_id": { "type": ["string", "null"] },
            "replay_ref": { "type": ["string", "null"] },
            "finish_reason": { "enum": ["stop", "length", "tool_call", "content_filter", "error"] },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_hash", "derived_from", "source_version"],
      "properties": {
        "package_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9-]{1,32}:)?[A-Z]{3,4}-\\d{5,}@v\\d+$"
          }
        },
        "source_version": { "type": "integer", "minimum": 1 }
      }
    },
    "body": { "type": "string", "minLength": 1 },
    "word_count": { "type": "integer", "minimum": 0 },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
