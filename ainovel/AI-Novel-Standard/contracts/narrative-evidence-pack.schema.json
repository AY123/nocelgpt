{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:narrative-evidence-pack:1.0",
  "title": "NarrativeEvidencePack",
  "description": "A compact, task-shaped evidence bundle for Genesis and Outline consumption. It contains only abstracted profiles, baselines, patterns, constraints, and provenance — never source prose or external identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "schema_version", "task", "corpus_snapshot_id", "query", "baselines", "patterns", "anti_patterns", "constraints", "originality", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^NEP-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "kind": { "const": "narrative_evidence_pack" },
    "schema_version": { "const": "1.0" },
    "task": { "enum": ["genesis", "chapter_plan", "long_arc"] },
    "corpus_snapshot_id": { "type": "string", "pattern": "^CORPUS-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genre", "target_reader", "chapter_index", "arc_stage", "target_function"],
      "properties": {
        "genre": { "type": "string", "minLength": 1 },
        "target_reader": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "chapter_index": { "type": "integer", "minimum": 1 },
        "arc_stage": { "type": "string", "minLength": 1 },
        "target_function": { "type": "string", "minLength": 1 },
        "current_problem": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "required_effect": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "baselines": { "type": "array", "items": { "$ref": "#/$defs/baseline" } },
    "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
    "anti_patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "originality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_cluster_count", "max_single_source_share", "risk_level"],
      "properties": {
        "source_cluster_count": { "type": "integer", "minimum": 0 },
        "max_single_source_share": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_hash", "query_hash", "retrieval_policy_version", "profile_ids"],
      "properties": {
        "snapshot_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "query_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "retrieval_policy_version": { "type": "string", "minLength": 1 },
        "profile_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slice", "sample_size", "signals"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slice": { "type": "string", "minLength": 1 },
        "sample_size": { "type": "integer", "minimum": 0 },
        "signals": { "type": "object", "additionalProperties": true }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern_type", "mechanism", "conditions", "effects", "support"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pattern_type": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "effects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "support": { "type": "object", "additionalProperties": false, "required": ["source_clusters", "top_profiles"], "properties": { "source_clusters": { "type": "integer", "minimum": 0 }, "top_profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
        "risk": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
