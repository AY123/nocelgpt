{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:task-package:1.0",
  "title": "Task Package",
  "description": "Artifact Contract (ADR-002) for a compiled Task Package. Defines the ENVELOPE only: entity records inside `context` are validated against their own generated entity schemas at registry-load time, not redefined here (ADR-007). This contract is authored (it is a contract, not a generated entity) and is the stable shape downstream agents consume instead of the Runtime compiler's internals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_format",
    "standard_version",
    "registry_version",
    "task",
    "provenance",
    "context",
    "content_hash"
  ],
  "properties": {
    "package_format": {
      "type": "string",
      "const": "1.0"
    },
    "standard_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "goal", "capability", "seeds"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^TASK-\\d{5,}$" },
        "goal": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z]{3,4}-\\d{5,}$" }
        },
        "extra": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from", "source_version"],
      "properties": {
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9-]{1,32}:)?[A-Z]{3,4}-\\d{5,}@v\\d+$"
          }
        },
        "source_version": { "type": "integer", "minimum": 1 }
      }
    },
    "context": {
      "type": "object",
      "description": "type_code -> list of entity records (validated against entity schemas elsewhere)",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object" }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token_budget": { "type": ["integer", "null"], "minimum": 0 },
    "entity_count": { "type": "integer", "minimum": 0 }
  }
}
