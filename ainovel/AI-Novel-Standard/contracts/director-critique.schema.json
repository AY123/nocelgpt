{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anes:contract:director-critique:1.0",
  "title": "DirectorCritique",
  "description": "Phase 6/7 director contract: the critique artifact that turns a produced draft plus its quality/commercial/signal context into a structured problem statement. It is the director's diagnostic step BEFORE a rewrite decision. This is a DERIVED production artifact, not a registry fact (ADR-006). Two structural invariants: `gating` const false (ADR-003) — a critique NEVER blocks a build; it is advisory diagnosis, and an evaluative critique cannot fail a chapter. `authority` const human (ADR-009) — a critique may recommend action but never auto-executes an outward/irreversible transition (publish, mint).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "authority",
    "gating",
    "chapter_id",
    "problem_dimensions",
    "scope",
    "actions",
    "priority",
    "expected_improvement",
    "acceptance_threshold"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CRT-\\d{5,}$" },
    "kind": { "type": "string", "const": "director_critique" },
    "authority": {
      "type": "string",
      "const": "human",
      "description": "Structural invariant (ADR-009): a critique diagnoses and recommends; it never auto-executes an outward/irreversible transition."
    },
    "gating": {
      "type": "boolean",
      "const": false,
      "description": "Structural invariant (ADR-003): a critique NEVER blocks a build. It is advisory evaluative diagnosis."
    },
    "schema_version": { "type": "string", "default": "1.0" },
    "chapter_id": { "type": "string", "minLength": 1 },
    "objective_ref": { "type": ["string", "null"] },
    "draft_ref": { "type": ["string", "null"] },
    "trigger_sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "problem_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["dimension", "severity", "issue"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "issue": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
    "expected_improvement": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "acceptance_threshold": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "quality_min": { "type": "integer", "minimum": 0, "maximum": 100 },
        "commercial_min": { "type": "integer", "minimum": 0, "maximum": 100 },
        "retention_min": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "human_notes": { "type": "string" },
    "notes": { "type": "string" }
  }
}
