{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChapterContract",
  "description": "写前章节契约 - Phase 1 MVP简化版",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapter",
    "version",
    "approved",
    "entry_state",
    "chapter_intent",
    "exit_target",
    "transition_to_next",
    "sources"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "description": "章节编号"
    },

    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$",
      "description": "契约版本，如v1.0"
    },

    "approved": {
      "type": "boolean",
      "description": "是否已人工批准"
    },

    "approved_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "批准时间，未批准时为null"
    },

    "approval_history": {
      "type": "array",
      "description": "审批历史记录（Task 3.3）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "approved", "approved_at", "approved_by"],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+$",
            "description": "此次审批对应的契约版本"
          },
          "approved": {
            "type": "boolean",
            "description": "是否批准"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "description": "审批时间"
          },
          "approved_by": {
            "type": "string",
            "description": "审批人"
          },
          "reason": {
            "type": "string",
            "description": "审批理由或备注"
          },
          "changes_from_previous": {
            "type": "string",
            "description": "相对于前一版本的变更说明"
          }
        }
      }
    },

    "entry_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id", "time_relation", "pov"],
      "properties": {
        "location_id": {
          "type": "string",
          "pattern": "^loc_[\\w\\u4e00-\\u9fa5_]+$",
          "description": "地点ID，如loc_赤曜矿脉_地宫外，支持中文"
        },

        "time_relation": {
          "type": "string",
          "enum": ["immediate", "short_gap", "jump", "flashback"],
          "description": "与上章的时间关系"
        },

        "pov": {
          "type": "string",
          "description": "视角人物名称"
        },

        "required_characters": {
          "type": "array",
          "items": {"type": "string"},
          "description": "必须在场的角色"
        },

        "hook_to_consume": {
          "type": "string",
          "pattern": "^hook_[0-9]{3}_[0-9]{2}$",
          "description": "需要消费的钩子ID，如hook_093_01"
        },

        "must_address": {
          "type": "string",
          "description": "开头必须处理的内容（自然语言）"
        }
      }
    },

    "chapter_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "main_conflict"],
      "description": "本章意图（从Objective派生）",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "description": "本章目标"
        },

        "main_conflict": {
          "type": "string",
          "minLength": 1,
          "description": "主要冲突"
        },

        "plot_lines": {
          "type": "array",
          "items": {"type": "string"},
          "description": "推进的剧情线"
        },

        "irreversible_change": {
          "type": "string",
          "description": "不可逆变化"
        }
      }
    },

    "exit_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id", "hook_id", "hook_promise"],
      "properties": {
        "location_id": {
          "type": "string",
          "pattern": "^loc_[\\w\\u4e00-\\u9fa5_]+$",
          "description": "结束时的地点ID，支持中文"
        },

        "time_state": {
          "type": "string",
          "description": "结束时的时间描述"
        },

        "characters_present": {
          "type": "array",
          "items": {"type": "string"},
          "description": "结束时在场的角色"
        },

        "unfinished_action": {
          "type": "string",
          "description": "未完成的动作/对话"
        },

        "hook_id": {
          "type": "string",
          "pattern": "^hook_[0-9]{3}_[0-9]{2}$",
          "description": "本章钩子ID"
        },

        "hook_promise": {
          "type": "string",
          "minLength": 1,
          "description": "钩子承诺的内容"
        }
      }
    },

    "transition_to_next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_continuity"],
      "properties": {
        "scene_continuity": {
          "type": "string",
          "enum": ["immediate", "short_gap", "scene_cut", "time_jump"],
          "description": "场景连续性类型"
        },

        "location_change": {
          "type": "boolean",
          "description": "下一章是否改变地点"
        },

        "pov_change": {
          "type": "boolean",
          "description": "下一章是否改变视角"
        },

        "consume_hook_by_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 20,
          "description": "钩子必须在下一章前N%消费"
        },

        "transition_note": {
          "type": "string",
          "description": "转场备注（可选）"
        }
      }
    },

    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "generated_from"],
      "description": "契约来源及哈希",
      "properties": {
        "outline_ref": {
          "type": ["string", "null"],
          "description": "对应的outline文件引用"
        },

        "long_arc_band": {
          "type": "integer",
          "description": "所属长弧band"
        },

        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "生成时间"
        },

        "generated_from": {
          "type": "string",
          "enum": ["manual", "ai_proposed", "migrated"],
          "description": "生成方式"
        },

        "content_hash": {
          "type": "string",
          "minLength": 1,
          "description": "内容哈希（用于检测过期）"
        },

        "based_on_chapter": {
          "type": "integer",
          "minimum": 1,
          "description": "基于哪一章的实际输出创建（可选）"
        },

        "ch100_exit_analysis": {
          "type": "object",
          "description": "前章出口分析（可选，用于辅助创建契约）"
        }
      }
    },

    "notes": {
      "type": "string",
      "description": "人工备注"
    }
  }
}
