DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# Kimi (Moonshot AI) — OpenAI-compatible; --model-provider kimi --model-id kimi-k3
MOONSHOT_API_KEY=sk-your-kimi-moonshot-api-key
# 92code — codex-style relay, OpenAI Responses API only.
# CODE92_MODEL defaults 92code calls to gpt-5.6-sol when --model-id is omitted.
# optional: CODE92_REASONING_EFFORT (default xhigh), CODE92_STORE (default false)
CODE92_API_KEY=sk-your-92code-relay-key
CODE92_MODEL=gpt-5.6-sol
