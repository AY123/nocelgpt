{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anes.local/schemas/chapter/chapter-draft.schema.json",
  "title": "Chapter Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_id", "version", "text"],
  "properties": {
    "chapter_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1 },
    "word_count": { "type": ["integer", "null"], "minimum": 0 },
    "draft_hash": { "type": ["string", "null"] },
    "style_profile": { "type": ["string", "null"] },
    "llm_meta": { "type": ["object", "null"], "additionalProperties": true },
    "produced_by": { "type": ["object", "null"], "additionalProperties": true },
    "source_refs": { "type": "array", "items": { "type": "string" } }
  }
}
