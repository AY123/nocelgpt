{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anes.local/schemas/chapter/chapter-intent.schema.json",
  "title": "Chapter Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["chapter_id", "chapter_no", "goal", "constraints"],
  "properties": {
    "chapter_id": { "type": "string", "minLength": 1 },
    "chapter_no": { "type": "integer", "minimum": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "conflict_target": { "type": ["string", "null"] },
    "emotion_target": { "type": ["string", "null"] },
    "information_target": { "type": ["string", "null"] },
    "commercial_target": { "type": ["string", "null"] },
    "hook_target": { "type": ["string", "null"] },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "required_facts": { "type": "array", "items": { "type": "string" } },
    "character_focus": { "type": "array", "items": { "type": "string" } },
    "state_cursor": { "type": ["string", "null"] }
  }
}
