{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anes.local/schemas/workflow-batch-audit.schema.json",
  "title": "Workflow Batch Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "version", "batch", "summary", "runs"],
  "properties": {
    "id": { "type": "string", "pattern": "^BATCH-[0-9]{5}$" },
    "kind": { "type": "string", "const": "workflow_batch_audit" },
    "version": { "type": "integer", "const": 1 },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_count", "started_at", "finished_at", "elapsed_ms"],
      "properties": {
        "run_count": { "type": "integer", "minimum": 0 },
        "started_at": { "type": ["string", "null"] },
        "finished_at": { "type": ["string", "null"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["succeeded", "blocked", "budget_spent"],
      "properties": {
        "succeeded": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "budget_spent": { "type": "number", "minimum": 0 }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "status", "cursor", "completed", "failed", "admission", "budget_spent", "produced", "skipped"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string" },
              "cursor": { "type": "integer", "minimum": 1 },
              "completed": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "admission": { "type": ["string", "null"], "enum": ["admit", "hold", null] },
              "budget_spent": { "type": ["number", "null"], "minimum": 0 },
              "produced": { "type": "integer", "minimum": 0 },
              "skipped": { "type": "integer", "minimum": 0 },
              "chapter_finals": {
                "type": "array",
                "description": "Chapter-final artifacts folded into the run audit (57f0f72); each item is the run_manifest chapter-final entry with a non-null final.",
                "items": { "type": "object" }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "status", "error"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "const": "blocked" },
              "error": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  }
}
