{
  "kind": "quality_golden_set_rollout_plan",
  "version": "1.0",
  "sample_count_target": 100,
  "phases": [
    {
      "phase": 1,
      "range": "QGS-00001..QGS-00010",
      "count": 10,
      "focus": ["seed coverage", "boundary calibration", "protocol validation"]
    },
    {
      "phase": 2,
      "range": "QGS-00011..QGS-00030",
      "count": 20,
      "focus": ["positive/negative balance", "专项失败模式扩充"]
    },
    {
      "phase": 3,
      "range": "QGS-00031..QGS-00060",
      "count": 30,
      "focus": ["golden-set diversity", "双编辑稳定性", "题材覆盖"]
    },
    {
      "phase": 4,
      "range": "QGS-00061..QGS-00100",
      "count": 40,
      "focus": ["regression coverage", "模型/提示词对比", "长期维护样本"]
    }
  ],
  "category_budget": {
    "positive": 24,
    "negative": 18,
    "boundary": 12,
    "ai_voice": 12,
    "padding": 12,
    "no_conflict": 10,
    "character_degradation": 7,
    "ending_failure": 5
  },
  "rollout_rules": {
    "seeds_locked_after_phase_1": true,
    "new_samples_must_include_meta_and_notes": true,
    "every_phase_must_refresh_distribution_checks": true,
    "phase_4_samples_must_include_regression_tags": true
  }
}