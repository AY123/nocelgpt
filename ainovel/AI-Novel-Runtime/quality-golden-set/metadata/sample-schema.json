{
  "kind": "quality_golden_set_sample_schema",
  "version": "1.0",
  "sample_id_pattern": "QGS-#####",
  "required_files": [
    "body.txt",
    "meta.json",
    "human_scores.json",
    "labels.json",
    "notes.md"
  ],
  "meta_fields": [
    "sample_id",
    "title",
    "genre",
    "chapter_position",
    "source_type",
    "source_hint",
    "risk_flags",
    "revision_candidate",
    "target_dimensions"
  ],
  "score_fields": [
    "editor_a",
    "editor_b",
    "consensus",
    "disagreement_notes",
    "final_judgement"
  ],
  "label_fields": [
    "problems",
    "strengths",
    "boundary_case",
    "recommended_action"
  ],
  "source_type_enum": [
    "positive",
    "negative",
    "boundary",
    "exemplar",
    "reference",
    "synthetic"
  ],
  "risk_flag_enum": [
    "copyright_risk",
    "sensitive_content",
    "contains_ai_voice",
    "contains_padding",
    "contains_no_conflict",
    "contains_character_degradation",
    "contains_ending_failure"
  ],
  "recommended_action_enum": [
    "keep",
    "revise",
    "exclude",
    "use_for_calibration_only"
  ],
  "governance": {
    "double_blind_required": true,
    "two_editor_minimum": true,
    "consensus_or_adjudication_required": true,
    "copyright_review_required": true,
    "sensitive_content_review_required": true
  }
}