{
  "kind": "w10_blind_review_result_template",
  "version": "1.0",
  "status": "draft",
  "purpose": "Template for filling one blind-review batch result once actual reviewer scores are available.",
  "required_fields": [
    "batch_id",
    "candidate_ids",
    "reviewer_notes",
    "comparison_result"
  ],
  "comparison_result": {
    "winner": "original | automatic_revision | human_revision | tie",
    "confidence": "low | medium | high",
    "reason_codes": [
      "improves_hook",
      "improves_continuity",
      "fixes_padding",
      "fixes_ai_voice",
      "fixes_conflict",
      "introduces_regression",
      "no_net_gain"
    ]
  },
  "batch_record_example": {
    "batch_id": "W10-B01",
    "candidate_ids": ["QGS-00001", "QGS-00002", "QGS-00003"],
    "reviewer_notes": [""],
    "comparison_result": {
      "winner": null,
      "confidence": null,
      "reason_codes": []
    }
  },
  "writeback_rules": {
    "fill_after_blind_review_only": true,
    "one_batch_one_record": true,
    "persist_reviewer_notes": true,
    "do_not_override_human_judgement": true
  }
}