{
  "kind": "quality_golden_set_schema",
  "version": "1.0",
  "required_sample_files": [
    "body.txt",
    "meta.json",
    "human_scores.json",
    "labels.json",
    "notes.md"
  ],
  "required_meta_fields": [
    "sample_id",
    "title",
    "genre",
    "chapter_position",
    "source_type",
    "risk_flags",
    "revision_candidate"
  ],
  "required_score_fields": [
    "editor_a",
    "editor_b",
    "consensus",
    "disagreement_notes"
  ],
  "required_label_categories": [
    "ai_voice",
    "padding",
    "no_conflict",
    "character_degradation",
    "ending_failure",
    "good_hook",
    "good_payoff",
    "boundary_case"
  ],
  "policy": {
    "double_blind_required": true,
    "contains_positive_and_negative_examples": true,
    "contains_boundary_cases": true,
    "reviewers_must_be_independent": true,
    "copyright_or_sensitive_content_must_be_flagged": true
  }
}