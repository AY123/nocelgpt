{
  "kind": "quality_golden_set_sample_protocol",
  "version": "1.0",
  "required_files": [
    "body.txt",
    "meta.json",
    "human_scores.json",
    "labels.json",
    "notes.md"
  ],
  "body_requirements": {
    "must_be_chinese": true,
    "must_be_source_text_or_structured_excerpt": true,
    "must_not_contain_secret_material": true
  },
  "meta_requirements": {
    "sample_id": true,
    "title": true,
    "genre": true,
    "chapter_position": true,
    "source_type": true,
    "risk_flags": true,
    "revision_candidate": true,
    "target_dimensions": true
  },
  "human_scores_requirements": {
    "editor_a": true,
    "editor_b": true,
    "consensus": true,
    "disagreement_notes": true,
    "final_judgement": true
  },
  "label_requirements": {
    "problems": true,
    "strengths": true,
    "boundary_case": true,
    "recommended_action": true
  },
  "notes_requirements": {
    "evidence_spans": true,
    "calibration_notes": true,
    "risk_notes": true
  }
}