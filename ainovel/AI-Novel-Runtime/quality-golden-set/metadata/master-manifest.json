{
  "kind": "anovel_master_manifest",
  "version": "1.0",
  "description": "Top-level governance manifest linking all runtime catalogs and templates",
  "catalogs": [
    {
      "name": "artifact_catalog",
      "ref": "metadata/artifact-catalog.json"
    },
    {
      "name": "quality_golden_set_index",
      "ref": "metadata/index.json"
    },
    {
      "name": "quality_rubric",
      "ref": "../../quality-rubric.yaml"
    },
    {
      "name": "reference_analysis_schema",
      "ref": "metadata/reference-analysis-schema.json"
    },
    {
      "name": "live_baseline_report",
      "ref": "runtime/serialize/live_baseline_report.py"
    }
  ],
  "governance": {
    "read_only": true,
    "catalogs_must_exist": true,
    "catalogs_must_be_tested": true,
    "references_must_be_updateable": true,
    "no_secret_material": true
  }
}