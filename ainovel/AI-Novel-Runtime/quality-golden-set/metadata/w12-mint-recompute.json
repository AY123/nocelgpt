{
  "kind": "w12_mint_recompute",
  "version": "1.0",
  "status": "draft",
  "purpose": "Define the single Mint entry point and recompute path for approved facts.",
  "mint_entry": {
    "name": "mint_fact",
    "required_fields": [
      "candidate_fact_id",
      "approval_record",
      "source_chapter",
      "fact_text",
      "evidence_span"
    ],
    "outputs": [
      "minted_fact_id",
      "projection_version",
      "recompute_status"
    ]
  },
  "recompute": {
    "required": true,
    "target": "next_chapter_state",
    "acceptance": "next chapter consumes the updated state"
  },
  "constraints": {
    "single_mint_entry": true,
    "no_backdoor_fact_writes": true,
    "approval_records_required": true
  },
  "next_actions": [
    "route approved facts through mint_fact",
    "recompute projections after mint",
    "verify next-chapter consumption",
    "record projection versions"
  ]
}